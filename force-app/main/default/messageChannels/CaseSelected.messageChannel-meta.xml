<?xml version="1.0" encoding="UTF-8"?>
<LightningMessageChannel xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Lets unrelated portal components talk to each other: a case was selected, created or updated.</description>
    <isExposed>false</isExposed>
    <lightningMessageFields>
        <description>Id of the case</description>
        <fieldName>recordId</fieldName>
    </lightningMessageFields>
    <lightningMessageFields>
        <description>What happened: selected | created | updated</description>
        <fieldName>action</fieldName>
    </lightningMessageFields>
    <masterLabel>Case Selected</masterLabel>
</LightningMessageChannel>
